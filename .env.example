# Server
PORT=3000

# Only set true when running behind a trusted reverse proxy (nginx etc.) so
# rate limiting reads the real client IP from X-Forwarded-For. Keep false
# otherwise: a spoofed X-Forwarded-For must not rotate rate-limit keys.
TRUST_PROXY=false

# Official dashboard session lifetime in hours (default 168 = 7 days).
SESSION_TTL_HOURS=168

# Alibaba Cloud DashScope (Qwen) - powers AI classification, routing and summaries.
# Without a key, DarKhwast falls back to a built-in offline rule-based classifier
# (keywords for Urdu / Roman Urdu / English) so the demo always works.
DASHSCOPE_API_KEY=
LLM_MODEL=qwen-plus

# SMTP for real outbound dispatch (Alibaba Cloud DirectMail or any free SMTP).
# Without SMTP_HOST, sends are SIMULATED: logged to console and recorded as
# "simulated" in the dispatch log. Safe demo mode, nothing leaves the machine.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=DarKhwast <complaints@example.com>

# Base URL used inside outbound letter footers (tracking link).
PUBLIC_BASE_URL=http://localhost:3000

# Seed sample complaints into the dashboard on first run (true/false)
SEED_SAMPLES=true
